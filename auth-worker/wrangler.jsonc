{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "rent-tracker-auth-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rent-tracker-auth",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "services": [
    {
      "binding": "EMAIL",
      "service": "rent-tracker-email-worker"
    }
  ],
  "vars": {
    "BETTER_AUTH_URL": "https://auth.rent-tracker.hornor.com",
    "APP_ORIGIN": "rent-tracker://app",
    "GOOGLE_CLIENT_IDS": ""
  }
}
